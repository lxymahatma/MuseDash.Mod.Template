<?xml version="1.0" encoding="utf-8" ?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <!-- ILRepack -->
    <Target Name="ILRepacker" AfterTargets="Build">
        <PropertyGroup>
            <WorkingDirectory>$(OutputPath)</WorkingDirectory>
        </PropertyGroup>
        <ItemGroup>
            <InputAssemblies Include="$(OutputPath)$(AssemblyName).dll"/>
            <InputAssemblies Include="@(RuntimeCopyLocalItems)" Exclude="@(RuntimeCopyLocalItems->WithMetadataValue('NuGetPackageId', 'MuseDashMirror'))"/>
            <IlRepackLibs Include="$(OutputPath)"/>
            <IlRepackLibs Include="$(MelonNET6)"/>
            <IlRepackLibs Include="$(MelonAssemblies)"/>
        </ItemGroup>
        <ILRepack
                Internalize="true"
                LibraryPath="@(IlRepackLibs)"
                OutputFile="$(OutputPath)$(AssemblyName).dll"
                InputAssemblies="@(InputAssemblies)"
                TargetKind="Dll"
                DebugInfo="true"
                Parallel="true"/>
    </Target>
    <!-- /ILRepack -->
</Project>
