<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageType>Template</PackageType>
        <PackageId>MuseDash.Mod.Template</PackageId>
        <Title>MuseDash Mod Template</Title>
        <Authors>lxy</Authors>
        <Description>Template for MuseDash Mod</Description>
        <PackageTags>dotnet-new;templates;MuseDash</PackageTags>
        <RepositoryUrl>https://github.com/lxymahatma/MuseDash.Mod.Template</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <TargetFramework>net6.0</TargetFramework>
        <IncludeContentInPack>true</IncludeContentInPack>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <ContentTargetFolders>content</ContentTargetFolders>
        <NoWarn>$(NoWarn);NU5128</NoWarn>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <LangVersion>latest</LangVersion>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <RootNamespace>templatepack</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
        <Content Include="MuseDashModTemplate\**\*" Exclude="MuseDashModTemplate\**\artifacts\**;MuseDashModTemplate\**\bin\**;MuseDashModTemplate\**\obj\**;MuseDashModTemplate\**\.idea\**;MuseDashModTemplate\MuseDashModTemplate.csproj"/>
        <Compile Remove="**\*"/>
    </ItemGroup>

    <Target Name="AddTemplateProject" BeforeTargets="_GetPackageFiles" DependsOnTargets="MinVer">
        <PropertyGroup>
            <_TemplateProject>$(MSBuildThisFileDirectory)MuseDashModTemplate\MuseDashModTemplate.csproj</_TemplateProject>
            <_PackedTemplateProject>$(IntermediateOutputPath)MuseDashModTemplate.csproj</_PackedTemplateProject>
        </PropertyGroup>
        <WriteLinesToFile File="$(_PackedTemplateProject)"
                          Lines="$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(_TemplateProject)').Replace('MUSEDASH_MOD_SDK_VERSION', '$(PackageVersion)').TrimEnd())))"
                          Overwrite="true"/>
        <ItemGroup>
            <None Include="$(_PackedTemplateProject)" Pack="true" PackagePath="content\MuseDashModTemplate\"/>
        </ItemGroup>
    </Target>

</Project>
